{
  "name": "enduro-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:electron\"",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pablogonzalez.endurodata",
    "productName": "EnduroData",
    "files": ["electron/**/*", "frontend/dist/**/*"],
    "extraResources": [{ "from": "backend", "to": "backend" }]
  }
}
